{
  "manifest_version": 3,
  "name": "Community Watch - Shopper Review Overlay",
  "version": "1.0.0",
  "description": "Independent, crowdsourced consumer feedback for online shopping listings. View and share honest delivery and product experiences.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Community Watch",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.flipkart.com/*",
    "https://zlfjzgveqzecaazbsjyu.supabase.co/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.flipkart.com/*"],
      "js": ["shared/api.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
